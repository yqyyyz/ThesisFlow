# ===== 聊天生成：DeepSeek 平台（写作/审查用 Pro，打分/摘要用 Flash）=====
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_STRONG=deepseek-v4-pro
MODEL_LIGHT=deepseek-v4-flash
# 思考模式（默认关闭：降低延迟、保证 JSON 输出稳定）
THINKING_ENABLED=false

# ===== 向量化/重排：百炼按量付费（sk- 开头，勿用 Token Plan 的 sk-sp- Key）=====
DASHSCOPE_API_KEY=sk-your-paygo-key-here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_EMBED=text-embedding-v4
MODEL_RERANK=gte-rerank-v2
RERANK_ENABLED=true
EMBED_DIM=1024
